# Postgres
DATABASE_URL="postgresql://fantasy:fantasy@localhost:5432/fantasy_sports?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL=http://localhost:3000/fantasy/api/auth
# Required behind the Netlify proxy: the app sees an internal host, not the domain.
AUTH_TRUST_HOST=true

# Encrypts provider credentials at rest. 32-byte base64 key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# ESPN Fantasy — private leagues need these two cookies from an authenticated
# browser session on fantasy.espn.com (DevTools > Application > Cookies).
# Set per-league in the admin UI; these are only a local dev fallback.
ESPN_SWID=""
ESPN_S2=""

# Yahoo Fantasy — register an app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""
YAHOO_REDIRECT_URI="http://localhost:3000/api/providers/yahoo/callback"

# --- Email -----------------------------------------------------------------
# Password reset links are emailed from here. Without SMTP_HOST + SMTP_USER the
# app says so on screen instead of pretending a message was sent, and an
# operator mints links with `pnpm exec tsx scripts/reset-link.mts <email>`.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public origin, used to build absolute links inside emails.
APP_URL=http://localhost:8000
